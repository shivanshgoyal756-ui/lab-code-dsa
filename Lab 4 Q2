#include <stdio.h>

struct student
{
    int roll_no;
    char fname[30];
    char lname[30];
};

int main() 
{
    struct student s[5], temp;
    for (int i = 0; i < 5; i++) 
    {
        printf("Student %d\n", i + 1);
        printf("Roll no: ");
        scanf("%d", &s[i].roll_no);
        printf("First name: ");
        scanf("%s", s[i].fname);
        printf("Last name: ");
        scanf("%s", s[i].lname);
    }

    for (int i = 0; i < 4; i++) 
    {
        for (int j = 0 ; j < 5-1-i; j++) 
        {
            if (s[j].roll_no > s[j+1].roll_no) 
            {
                temp = s[j];
                s[j] = s[j+1];
                s[j+1] = temp;
            }
        }
    }

    printf("\nRecords in ascending order of roll no:\n");
    for (int i = 0; i < 5; i++) 
    {
        printf("%d %s %s\n", s[i].roll_no, s[i].fname, s[i].lname);
    }

    return 0;
}
