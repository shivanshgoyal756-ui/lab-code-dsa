#include <stdio.h>

struct employee 
{
    char name[50];
    char address[100];
    int age;
    float salary;
};

int main() 
{
    int n;
    printf("Enter number of employees: ");
    scanf("%d", &n);

    struct employee e[n];
    float sum = 0;

    for (int i = 0; i < n; i++)
    {
        printf("\nEmployee %d\n", i + 1);

        printf("Name: ");
        scanf(" %[^\n]", e[i].name);

        printf("Address: ");
        scanf(" %[^\n]", e[i].address);

        printf("Age: ");
        scanf("%d", &e[i].age);

        printf("Salary: ");
        scanf("%f", &e[i].salary);

        sum += e[i].salary;
    }

    printf("\nAverage salary = %.2f\n", sum / n);

    return 0;
}
