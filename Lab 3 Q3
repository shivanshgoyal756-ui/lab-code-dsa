#include <stdio.h>
struct employee
{
    char name[30];
    char address[50];
    int age;
    float salary;
};

int main()
{
    struct employee e[100];
    int n, i;
    float sum = 0, avg;
    printf("Enter number of employees: ");
    scanf("%d", &n);
    for (i = 0; i < n; i++)
    {
        printf("\nEnter details of employee %d\n", i + 1);
        printf("Name: ");
        scanf("%[^\n]", &e[i].name);
        printf("Address: ");
        scanf("%[^\n]",& e[i].address);
        printf("Age: ");
        scanf("%d", &e[i].age);
        printf("Salary: ");
        scanf("%f", &e[i].salary);
        sum += e[i].salary;
    }
    avg = sum / n;
    printf("\nAverage Salary = %.2f\n", avg);
    return 0;
}
