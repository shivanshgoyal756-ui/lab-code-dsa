#include <stdio.h>
struct student
{
    int roll_no;
    char fname[20];
    char lname[20];
};
int main() 
{
    struct student s[5], temp;
    int i, j;
    for (i = 0; i < 5; i++) 
    {
        printf("\nEnter details of student %d\n", i + 1);
        printf("Roll No: ");
        scanf("%d", &s[i].roll_no);
        printf("First Name: ");
        scanf("%s", s[i].fname);
        printf("Last Name: ");
        scanf("%s", s[i].lname);
    }
    for (i = 0; i < 4; i++) 
    {
        for (j =0 ; j < 4-i; j++)
        {
            if (s[j].roll_no > s[j+1].roll_no) 
            {
                temp = s[j];
                s[j] = s[j+1];
                s[j+1] = temp;
            }
        }
    }
    printf("\nStudent records in Ascending Order of Roll No \n");
    for (i = 0; i < 5; i++)
    {
        printf("%d  %s  %s\n", s[i].roll_no, s[i].fname, s[i].lname);
    }
    return 0;
}
